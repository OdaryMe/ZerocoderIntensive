# Пример переменных окружения для Signal — AI Job Digest.
# Скопируйте этот файл в файл .env и заполните его при необходимости.
# Секреты пишите только в .env — этот пример-файл секретов не содержит
# и его можно спокойно коммитить.

# --- Сервер -------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
# 1 включает режим отладки Flask (полезно при разработке)
FLASK_DEBUG=0

# --- Источники вакансий (RSS/Atom ленты через запятую) -------------------
# Пока пусто — приложение работает в демонстрационном режиме на тестовых данных.
# Пример:
# SIGNAL_FEEDS=https://example.com/jobs.xml, https://example.org/feed
SIGNAL_FEEDS=

# --- Необязательная AI-интеграция для текстового резюме дайджеста -------
# Нужен любой OpenAI-совместимый API (Chat Completions).
# Без этих переменных всё работает: аналитика считается локально,
# а блок «AI-резюме» показывает подсказку по настройке.
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4o-mini
